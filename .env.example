DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delivery"
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"

# Cobrança (opcional em desenvolvimento). Ver deploy/README.md
# ASAAS_API_KEY='$aact_...'
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=
# Endereço público do sistema (vai no webhook das subcontas das lojas)
# APP_URL=https://app.webtenda.com.br
# Opcional: segredo para criptografar as chaves das subcontas (senão usa AUTH_SECRET)
# PAYMENTS_ENCRYPTION_KEY=

# E-mails (separados por vírgula) com acesso a /admin. Cadastre a conta ANTES de preencher.
# ADMIN_EMAILS=
