# Copie para .env.production no VPS e preencha. NUNCA suba este arquivo preenchido para o GitHub.

# Senha do banco (só letras e números, para não precisar escapar). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Segredo das sessões de login. Gere com: openssl rand -base64 32
AUTH_SECRET=

# --- Asaas ---
# A chave do Asaas começa com "$". Mantenha as aspas simples, senão o "$" é interpretado.
ASAAS_API_KEY='$aact_...'
# Teste (sandbox): https://api-sandbox.asaas.com/v3   Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que você mesmo inventa e cola também no cadastro do webhook no Asaas. Gere com: openssl rand -hex 24
ASAAS_WEBHOOK_TOKEN=

# E-mails (separados por vírgula) com acesso a /admin. Cadastre a conta ANTES de preencher.
ADMIN_EMAILS=

# Opcional: "Entrar com Google" para o lojista (ver deploy/README.md). Vazio esconde o botão.
# Redirecionamento no Google Cloud: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Opcional: Google Agenda das barbearias/salões (precisa das duas acima). Ver deploy/README.md.
# GOOGLE_AGENDA=1
