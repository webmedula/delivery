# Copie para .env.production no VPS e preencha. NUNCA suba este arquivo preenchido para o GitHub.

# Senha do banco (só letras e números, para não precisar escapar). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Segredo das sessões de login. Gere com: openssl rand -base64 32
AUTH_SECRET=

# --- Asaas ---
# A chave do Asaas começa com "$". Mantenha as aspas simples, senão o "$" é interpretado.
ASAAS_API_KEY='$aact_...'
# Teste (sandbox): https://api-sandbox.asaas.com/v3   Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que você mesmo inventa e cola também no cadastro do webhook no Asaas. Gere com: openssl rand -hex 24
ASAAS_WEBHOOK_TOKEN=
