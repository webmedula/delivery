// Banco multi-tenant: cada loja (Store) é um tenant.
// Toda tabela de dados da loja carrega storeId, e o código do painel
// só consulta através de helpers que filtram pelo storeId da sessão.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  SUPERADMIN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum OrderStatus {
  PENDING    // recebido
  CONFIRMED  // aceito pela loja
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  COMPLETED
  CANCELED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum DiscountType {
  PERCENT // valor = porcentagem (1 a 100)
  FIXED   // valor = centavos
}

enum PaymentMethod {
  PIX              // Pix pela chave da loja (conferência manual)
  CASH
  CARD_ON_DELIVERY
  ONLINE_PIX       // Pix pago no cardápio, pela subconta Asaas da loja
  ONLINE_CARD      // cartão de crédito pago no cardápio, pela subconta Asaas da loja
}

// Situação do pagamento online do pedido. Pedidos pagos na entrega ficam NONE.
enum PaymentStatus {
  NONE
  AWAITING  // cobrança gerada, esperando o cliente pagar
  PAID
  EXPIRED   // venceu sem pagamento (o pedido é cancelado)
  REFUNDED
  FAILED    // não deu para gerar a cobrança
}

model Plan {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  priceCents       Int
  maxProducts      Int      // limite de produtos no cardápio (0 = ilimitado)
  maxOrdersMonth   Int      // limite de pedidos/mês (0 = ilimitado)
  active           Boolean  @default(true)
  stores           Store[]
  createdAt        DateTime @default(now())
}

model Store {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  description        String?
  whatsapp           String?            // só dígitos, com DDI: 5511999999999
  address            String?
  logoUrl            String?
  themeColor         String?            // cor do cardápio, ex.: #ea580c (vazio = laranja WebTenda)
  isOpen             Boolean            @default(true)
  deliveryFeeCents   Int                @default(0)
  minOrderCents      Int                @default(0)
  acceptsDelivery    Boolean            @default(true)
  acceptsPickup      Boolean            @default(true)
  pixKey             String?
  // Tempo estimado mostrado ao cliente, em minutos (vazio = não mostra).
  deliveryMinutesMin Int?
  deliveryMinutesMax Int?
  pickupMinutesMin   Int?
  pickupMinutesMax   Int?
  deliveryZones      DeliveryZone[]

  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  cpfCnpj               String?         // só dígitos; exigido pelo Asaas para cobrar
  billingCustomerId     String?         // id do cliente no Asaas (cus_...)
  billingSubscriptionId String? @unique // id da assinatura no Asaas (sub_...)

  // Bloqueio manual feito pelo administrador da plataforma (independe da assinatura).
  blockedAt          DateTime?
  blockedReason      String?

  // Loja de demonstração (prisma/demo.ts): não cobra assinatura, não liga
  // pagamento online e fica fora dos números da administração.
  isDemo             Boolean            @default(false)

  // Programa de fidelidade: a cada N pedidos concluídos, o cliente ganha um desconto.
  loyaltyEnabled        Boolean      @default(false)
  loyaltyOrdersRequired Int          @default(10)
  loyaltyRewardType     DiscountType @default(PERCENT)
  loyaltyRewardValue    Int          @default(10)
  loyaltyMinOrderCents  Int          @default(0) // subtotal mínimo para o pedido contar selo

  // Pagamento online: cada loja tem a própria subconta no Asaas, criada pela
  // plataforma. O dinheiro cai direto nela; a WebTenda não fica com nada.
  asaasAccountId        String?   @unique
  asaasWalletId         String?
  asaasApiKeyEnc        String?   // chave da subconta, criptografada (lib/secret-box)
  asaasAccountStatus    String?   // situação geral no Asaas: PENDING, AWAITING_APPROVAL, APPROVED, REJECTED
  onlinePixEnabled      Boolean   @default(false)
  onlineCardEnabled     Boolean   @default(false)

  users              User[]
  customers          Customer[]
  coupons            Coupon[]
  campaigns          Campaign[]
  categories         Category[]
  products           Product[]
  orders             Order[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OWNER)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Category {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  position  Int       @default(0)
  products  Product[]

  @@index([storeId])
}

model Product {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  available   Boolean     @default(true)
  position    Int         @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())

  @@index([storeId])
}

model Order {
  id               String          @id @default(cuid())
  storeId          String
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number           Int             // sequencial por loja, mostrado ao cliente
  status           OrderStatus     @default(PENDING)
  fulfillment      FulfillmentType
  paymentMethod    PaymentMethod
  changeForCents   Int?            // troco para (dinheiro)
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String
  address          String?
  notes            String?
  subtotalCents    Int
  deliveryFeeCents Int
  discountCents    Int             @default(0)
  couponId         String?
  coupon           Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String?         // cópia do código no momento do pedido
  loyaltyReward    Boolean         @default(false) // usou a recompensa de fidelidade
  totalCents       Int
  paymentStatus    PaymentStatus   @default(NONE)
  paymentId        String?         @unique // cobrança no Asaas (pay_...)
  paymentUrl       String?         // fatura do Asaas (usada para pagar com cartão)
  paidAt           DateTime?
  // Bairro escolhido (quando a loja cobra taxa por bairro). Nome copiado no momento do pedido.
  deliveryZoneId   String?
  deliveryZone     DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryZoneName String?
  // Previsão em minutos a partir da criação, copiada da loja no momento do pedido.
  etaMinutesMin    Int?
  etaMinutesMax    Int?
  // Quando o pedido passou por cada etapa (para histórico e tempo médio).
  acceptedAt       DateTime?
  dispatchedAt     DateTime?       // saiu para entrega / ficou pronto para retirar
  completedAt      DateTime?
  canceledAt       DateTime?
  items            OrderItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([storeId, number])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([couponId])
  @@index([storeId, status])
}

// Bairro atendido e sua taxa de entrega. Se a loja tem bairros, o cliente escolhe um na sacola
// e a taxa única da loja deixa de valer.
model DeliveryZone {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  feeCents  Int
  active    Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())

  @@unique([storeId, name])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String  // cópia do nome no momento do pedido
  unitPriceCents Int     // cópia do preço no momento do pedido
  quantity       Int
  notes          String?
}

// Eventos de webhook já processados (o Asaas pode reenviar o mesmo evento).
model BillingEvent {
  id         String   @id // id do evento enviado pelo Asaas (evt_...)
  type       String
  storeId    String?
  receivedAt DateTime @default(now())
}

// Registro do que o administrador da plataforma fez (bloqueios, trocas de plano etc.).
model AdminLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  storeId    String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
}

// Cliente final de uma loja. Cada loja tem a sua base de clientes (o mesmo
// telefone em duas lojas são dois registros). Identificado pelo telefone.
model Customer {
  id              String            @id @default(cuid())
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phone           String            // só dígitos, com DDD e sem o 55: 11999999999
  name            String
  marketingOptIn  Boolean           @default(false) // aceitou receber promoções
  cpfCnpj         String?           // informado ao pagar online (o Asaas exige)
  asaasCustomerId String?           // cliente na subconta Asaas da loja
  pinHash         String?           // PIN opcional para entrar em outro aparelho
  pinFailures     Int               @default(0)
  pinLockedUntil  DateTime?
  loginCodeHash      String?   // código de acesso de uso único, enviado pela loja no WhatsApp
  loginCodeExpiresAt DateTime?
  addresses       CustomerAddress[]
  orders          Order[]
  campaignSends   CampaignRecipient[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([storeId, phone])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address    String
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([customerId, address])
}

model Coupon {
  id               String       @id @default(cuid())
  storeId          String
  store            Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code             String       // sempre em maiúsculas
  type             DiscountType
  value            Int
  minOrderCents    Int          @default(0)
  maxUses          Int          @default(0) // 0 = ilimitado
  oncePerCustomer  Boolean      @default(true)
  firstOrderOnly   Boolean      @default(false)
  expiresAt        DateTime?
  active           Boolean      @default(true)
  orders           Order[]
  campaigns        Campaign[]
  createdAt        DateTime     @default(now())

  @@unique([storeId, code])
}

// Campanha de promoção. O envio é feito pelo WhatsApp da própria loja,
// um cliente por vez (link wa.me), só para quem aceitou receber promoções.
// A lista de destinatários é congelada na criação.
model Campaign {
  id         String              @id @default(cuid())
  storeId    String
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  message    String              // modelo com {nome}, {loja}, {link}, {cupom}
  audience   String              // all | inactive | new | reward
  couponId   String?
  coupon     Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]
  createdAt  DateTime            @default(now())

  @@index([storeId, createdAt])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sentAt     DateTime?
  skipped    Boolean   @default(false)

  @@unique([campaignId, customerId])
}
